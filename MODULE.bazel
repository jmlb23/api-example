module(name = "api-example", version = "0.1")


bazel_dep(name = "rules_dotnet", version = "")


git_override(
    module_name = "rules_dotnet",
    remote = "https://github.com/bazel-contrib/rules_dotnet",
    commit = "ee9ae747d763cf9fa4d677586fb395cafa6ed3a1",
)



paket = use_extension("@rules_dotnet//dotnet:paket.bzl", "paket")
paket.parse(
    dependencies = "//:paket.dependencies",
    lock = "//:paket.lock",
)
use_repo(paket, "paket.main")
